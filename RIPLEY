#!/bin/bash

set -o errexit
set -o nounset

case "$1" in
    mitochondrial_haplotypes | selection_scan | linkage_diagnostics | population_structure | genotype_diagnostics | alignment_diagnostics)
        echo "Launching pipeline: $1"
        ;;
    *)
        echo "Error: '$1' is not a pipeline." >&2
        echo "Valid options are ..." >&2
        echo "> alignment_diagnostics" >&2
        echo "> genotype_diagnostics" >&2
        echo "> linkage_diagnostics" >&2
        echo "> mitochondrial_haplotypes" >&2
        echo "> population_structure" >&2
        echo "> selection_scan" >&2
        exit 1
        ;;
esac

this=$(readlink -f "$0")
repo=$(dirname "$this")
cd $repo

nextflow -log ".nextflow/nextflow.log" run "./source/nf/main/${1}.nf" \
    -with-report "output/${1}/run.html" \
    -params-file "options.yaml" \
    -resume
