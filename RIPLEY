#!/bin/bash

set -o errexit
set -o nounset

case "$1" in
    mitochondrial_haplotypes | selection_scan | population_structure | filter_variants | control_variants | control_alignments)
        echo "Launching pipeline: $1"
        ;;
    *)
        echo "Error: '$1' is not a pipeline." >&2
        echo "Valid options are ..." >&2
        echo "> control_alignments" >&2
        echo "> control_variants" >&2
        echo "> filter_variants" >&2
        echo "> mitochondrial_haplotypes" >&2
        echo "> population_structure" >&2
        echo "> selection_scan" >&2
        exit 1
        ;;
esac

this=$(readlink -f "$0")
repo=$(dirname "$this")
cd $repo

nextflow -log ".nextflow/nextflow.log" run "./source/nf/entry/${1}.nf" \
    -with-report "output/${1}/run.html" \
    -params-file "options.yaml" \
    -resume
