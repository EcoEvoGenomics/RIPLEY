includeConfig "../../common/nextflow.config"

conda.enabled = true
conda.channels = "conda-forge,bioconda"
conda.createTimeout = 1.h

process {

  withLabel: "ADMIXTURE" {
    container = "quay.io/biocontainers/admixture:1.3.0--0"
    cpus = 8
    memory = 32.GB
    time = 4.h
  }

  withLabel: "PLINK" {
    container = "quay.io/biocontainers/plink:1.90b7.7--h18e278d_1"
    cpus = 4
    memory = 16.GB
    time = 4.h
  }

  withLabel: "RDATA" {
    conda = "r-tidyverse r-data.table"
    cpus = 4
    memory = 16.GB
    time = 4.h
  }

  withLabel: "RPLOT" {
    conda = "conda-forge::r-ggplot2=4.0.3 conda-forge::r-scales=1.4.0 conda-forge::r-patchwork=1.3.2 conda-forge::r-gtable=0.3.6 conda-forge::r-scico=1.5.0 r-ggdendro r-tidyverse r-forcats r-gtools r-data.table"
    cpus = 1
    memory = 8.GB
    time = 1.h
  }

}
