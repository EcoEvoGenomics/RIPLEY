includeConfig "../../common/nextflow.config"

conda.enabled = true
conda.channels = "conda-forge,bioconda"
conda.createTimeout = 1.h

process {

  withLabel: "ADMIXTURE" {
    container = "quay.io/biocontainers/admixture:1.3.0--0"
    cpus = 8
    memory = 32.GB
    time = 4.h
  }

  withLabel: "PLINK" {
    container = "quay.io/biocontainers/plink:1.90b7.7--h18e278d_1"
    cpus = 4
    memory = 16.GB
    time = 4.h
  }

  withLabel: "RDATA" {
    conda = "r-tidyverse=2.0.0 r-data.table=1.18.6.1"
    cpus = 4
    memory = 16.GB
    time = 4.h
  }

  withLabel: "RPLOT" {
    conda = "r-ggplot2=4.0.3 r-patchwork=1.3.2 r-scico=1.5.0 r-ggdendro=0.2.0 r-tidyverse=2.0.0 r-data.table=1.18.6.1"
    cpus = 1
    memory = 8.GB
    time = 1.h
  }

}
