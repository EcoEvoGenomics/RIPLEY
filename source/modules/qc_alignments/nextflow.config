includeConfig "../../common/nextflow.config"

conda.enabled = true
conda.channels = "conda-forge,bioconda"
conda.createTimeout = 1.h

process {

  withLabel: "RPLOT" {
    conda = "conda-forge::r-ggplot2=4.0.3 conda-forge::r-scales=1.4.0 conda-forge::r-patchwork=1.3.2 conda-forge::r-gtable=0.3.6 r-ggdendro r-tidyverse r-forcats r-gtools r-data.table"
    cpus = 1
    memory = 8.GB
    time = 1.h
  }

}
